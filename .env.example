# ==============================================================================
# Telecom Customer Churn & Retention Platform (CCATI) - Environment Example
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit the actual .env file with real credentials or secrets to version control.
# ==============================================================================

# Application Environment & Debug Settings
APP_ENV=development
DEBUG=false
PROJECT_NAME="Telecom Customer Churn Analysis Platform"
VERSION="1.0.0"

# Security & JWT Authentication (TASK 17 Production RBAC)
# Generate strong 256-bit secrets in production: openssl rand -hex 32
SECRET_KEY=<set-in-environment>
JWT_SECRET_KEY=<set-in-environment>
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Network & CORS Configuration (Specify explicit production origins, NO wildcards with credentials)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
HOST="0.0.0.0"
PORT=8000
MAX_REQUEST_SIZE_BYTES=10485760

# Database Configuration (PostgreSQL persistent storage)
DATABASE_URL="postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/telecom_churn"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# Observability & Audit Logging (TASK 12)
LOG_LEVEL="INFO"
LOG_FORMAT="json"
ENABLE_AUDIT_LOGGING=true
ENABLE_METRICS=true
AUDIT_RETENTION_DAYS=90
REQUEST_ID_HEADER="X-Request-ID"

# Rate Limiting & Abuse Protection (TASK 19)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_PREDICTION_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=30

# Kaggle Dataset Integration (TASK 21)
# Obtain credentials from https://www.kaggle.com/account/settings/api
# Click "Create New API Token" and extract from ~/.kaggle/kaggle.json
KAGGLE_USERNAME=<your_kaggle_username>
KAGGLE_KEY=<your_kaggle_api_key>

# ML Model Configuration
ML_MODEL_TYPE="gradient_boosting"
ML_RANDOM_STATE=42
SMOTE_ENABLED=true
SMOTE_SAMPLING_STRATEGY=0.5
TEST_SPLIT_RATIO=0.2
RATE_LIMIT_EXPORT_PER_MINUTE=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
TRUSTED_PROXIES="127.0.0.1,::1"
ENABLE_HSTS=false

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL="http://localhost:8000"

