# ==============================================================================
# Telecom Customer Churn & Retention Platform - Environment Configuration Example
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit the actual .env file with real credentials or secrets to version control.
# ==============================================================================

# Application Environment & Debug Settings
APP_ENV=development
DEBUG=false
PROJECT_NAME="Telecom Customer Churn Analysis Platform"
VERSION="1.0.0"

# Security & JWT Authentication
# In production, generate a cryptographically strong 32+ character key: openssl rand -hex 32
SECRET_KEY="generate_a_secure_random_key_for_production_use_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
HOST="0.0.0.0"
PORT=8000

# Database Configuration
DATABASE_URL="sqlite:///data/database/telecom_churn.db"

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL="http://localhost:8000"
